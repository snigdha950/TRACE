  "components": {
    "schemas": {
      "AlertRequest": {
        "properties": {
          "event_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Event Id"
          },
          "valid_time": {
            "type": "string",
            "format": "date-time",
            "title": "Valid Time"
          },
          "forecast_lead_hours": {
            "type": "integer",
            "maximum": 240.0,
            "minimum": 72.0,
            "title": "Forecast Lead Hours",
            "description": "Medium-range forecast lead, 3 to 10 days."
          },
          "core_lat": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Core Lat"
          },
          "core_lon": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Core Lon"
          },
          "macro_footprint_area_km2": {
            "type": "number",
            "maximum": 510100000.0,
            "exclusiveMinimum": 0.0,
            "title": "Macro Footprint Area Km2"
          },
          "macro_footprint_geojson": {
            "additionalProperties": true,
            "type": "object",
            "title": "Macro Footprint Geojson"
          },
          "evidence": {
            "$ref": "#/components/schemas/EvidenceInput"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_id",
          "valid_time",
          "forecast_lead_hours",
          "core_lat",
          "core_lon",
          "macro_footprint_area_km2",
          "macro_footprint_geojson",
          "evidence"
        ],
        "title": "AlertRequest"
      },
      "ControlledReplayRequest": {
        "properties": {
          "records": {
            "items": {
              "$ref": "#/components/schemas/ReplayRecord"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Records"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "records"
        ],
        "title": "ControlledReplayRequest"
      },
      "EvidenceInput": {
        "properties": {
          "max_ensemble_mean_wind_ms": {
            "type": "number",
            "minimum": 0.0,
            "title": "Max Ensemble Mean Wind Ms",
            "description": "Maximum ensemble-mean wind speed inside the candidate footprint."
          },
          "max_efi": {
            "type": "number",
            "maximum": 1.0,
            "minimum": -1.0,
            "title": "Max Efi",
            "description": "Extreme Forecast Index. Positive extremes approach +1."
          },
          "max_member_support_fraction": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Max Member Support Fraction"
          },
          "mean_seed_agreement": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Mean Seed Agreement"
          },
          "max_sot": {
            "type": "number",
            "title": "Max Sot",
            "description": "Shift of Tails evidence. Positive values corroborate tail shift."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "max_ensemble_mean_wind_ms",
          "max_efi",
          "max_member_support_fraction",
          "mean_seed_agreement",
          "max_sot"
        ],
        "title": "EvidenceInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ProviderMetadataRequest": {
        "properties": {
          "provider_name": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Provider Name"
          },
          "dimensions": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Dimensions"
          },
          "variables": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ],
            "title": "Variables"
          },
          "coordinates": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ],
            "title": "Coordinates"
          },
          "initialization_time": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Initialization Time"
          },
          "valid_times": {
            "items": {
              "type": "string",
              "format": "date-time"
            },
            "type": "array",
            "title": "Valid Times"
          },
          "lead_hours": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Lead Hours"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "provider_name",
          "dimensions",
          "variables"
        ],
        "title": "ProviderMetadataRequest"
      },
      "ReplayRecord": {
